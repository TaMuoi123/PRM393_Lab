Id w:val="1"/></w:numPr></w:pPr><w:r w:rsidRPr="0083697A"><w:t xml:space="preserve">Building a real-world </w:t></w:r><w:r w:rsidRPr="0083697A"><w:rPr><w:b/><w:bCs/></w:rPr><w:t>Genre Filtering Screen</w:t></w:r><w:r w:rsidRPr="0083697A"><w:t xml:space="preserve"> similar to the one shown in Figures 6.1–6.9 of </w:t></w:r><w:r w:rsidRPr="0083697A"><w:rPr><w:i/><w:iCs/></w:rPr><w:t>Mastering Flutter 2025</w:t></w:r><w:r w:rsidRPr="0083697A"><w:t>.</w:t></w:r></w:p><w:p w14:paraId="573DDDC1" w14:textId="77777777" w:rsidR="0083697A" w:rsidRPr="0083697A" w:rsidRDefault="0083697A" w:rsidP="0083697A"><w:r w:rsidRPr="0083697A"><w:t xml:space="preserve">At the end, students will have a </w:t></w:r><w:r w:rsidRPr="0083697A"><w:rPr><w:b/><w:bCs/></w:rPr><w:t>fully functional responsive screen</w:t></w:r><w:r w:rsidRPr="0083697A"><w:t xml:space="preserve"> that runs correctly in:</w:t></w:r></w:p><w:p w14:paraId="7B712C05" w14:textId="77777777" w:rsidR="0083697A" w:rsidRPr="0083697A" w:rsidRDefault="0083697A" w:rsidP="0083697A"><w:pPr><w:numPr><w:ilvl w:val="0"/><w:numId w:val="2"/></w:numPr></w:pPr><w:r w:rsidRPr="0083697A"><w:t>DartPad (Flutter)</w:t></w:r></w:p><w:p w14:paraId="3FB2C622" w14:textId="77777777" w:rsidR="0083697A" w:rsidRPr="0083697A" w:rsidRDefault="0083697A" w:rsidP="0083697A"><w:pPr><w:numPr><w:ilvl w:val="0"/><w:numId w:val="2"/></w:numPr></w:pPr><w:r w:rsidRPr="0083697A"><w:t>Android Studio</w:t></w:r></w:p><w:p w14:paraId="4867EC2E" w14:textId="77777777" w:rsidR="0083697A" w:rsidRPr="0083697A" w:rsidRDefault="0083697A" w:rsidP="0083697A"><w:pPr><w:numPr><w:ilvl w:val="0"/><w:numId w:val="2"/></w:numPr></w:pPr><w:r w:rsidRPr="0083697A"><w:t>VS Code</w:t></w:r></w:p><w:p w14:paraId="0578EEDB" w14:textId="77777777" w:rsidR="0083697A" w:rsidRPr="0083697A" w:rsidRDefault="0083697A" w:rsidP="0083697A"><w:pPr><w:rPr><w:b/><w:bCs/></w:rPr></w:pPr><w:r w:rsidRPr="0083697A"><w:rPr><w:b/><w:bCs/></w:rPr><w:t>2. Requirements</w:t></w:r></w:p><w:p w14:paraId="0B70050